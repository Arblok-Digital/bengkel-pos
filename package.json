{
  "name": "bengkel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run --silent db:up",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pree2e": "npm run --silent db:up",
    "e2e": "playwright test",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 up",
    "db:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 down",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 status",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 reset",
    "wsl:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 off"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
